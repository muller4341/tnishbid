generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  phone_number   String   @unique
  email          String?  @unique
  password_hash  String
  role           String   @default("user")
  wallet_balance Float    @default(0.00)
  image_url      String?
  created_at     DateTime @default(now())

  bids           Bid[]
  notifications  Notification[]
  won_items      Item[]         @relation("Winner")
  chapa_payments ChapaPayment[]
}

model Item {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  image_url   String?
  images      String[] @default([])
  category    String   @default("Electronics")
  is_lub      Boolean  @default(false)
  pool_type   String   @default("open")
  base_price  Float
  start_time  DateTime
  end_time    DateTime
  status      String   @default("active")
  winner_id   Int?
  created_at  DateTime @default(now())

  winner         User?          @relation("Winner", fields: [winner_id], references: [id])
  bids           Bid[]
  chapa_payments ChapaPayment[]

  @@index([status])
  @@index([end_time])
  @@index([created_at])
  @@index([pool_type])
}

model ChapaPayment {
  id         Int      @id @default(autoincrement())
  tx_ref     String   @unique
  chapa_ref  String?
  amount     Float
  bid_amount Float
  status     String   @default("pending")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user_id Int
  user    User @relation(fields: [user_id], references: [id])
  item_id Int
  item    Item @relation(fields: [item_id], references: [id])

  @@index([user_id])
  @@index([item_id])
  @@index([status])
}

model Bid {
  id         Int      @id @default(autoincrement())
  amount     Float
  is_unique  Boolean  @default(true)
  created_at DateTime @default(now())

  item_id Int
  item    Item @relation(fields: [item_id], references: [id])

  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  @@index([item_id])
  @@index([user_id])
  @@index([item_id, amount])
  @@index([created_at])
}

model Notification {
  id         Int      @id @default(autoincrement())
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([created_at])
}
