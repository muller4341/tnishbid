DATABASE_URL=postgresql://postgres:password@localhost:5432/tinish_bid?schema=public
JWT_SECRET=replace_with_a_long_random_secret
PORT=3000

# Keep this server-side. Never expose CHAPA_SECRET_KEY to the frontend.
CHAPA_SECRET_KEY=CHASECK-your-server-secret
CHAPA_DEFAULT_EMAIL=mulerwalle@gmail.com
# Public HTTPS URL reachable by Chapa, for example https://api.example.com
BACKEND_PUBLIC_URL=https://api.example.com
# Frontend URL used after Chapa verifies the payment
FRONTEND_URL=https://app.example.com
# Optional override if your callback URL differs from BACKEND_PUBLIC_URL
CHAPA_CALLBACK_URL=https://api.example.com/api/payments/chapa/callback