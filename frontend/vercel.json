{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://tnishbid-3.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://tnishbid-3.onrender.com/uploads/$1"
    },
    {
      "source": "/((?!api|uploads|socket.io).*)" ,
      "destination": "/index.html"
    }
  ]
}
